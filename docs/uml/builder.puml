@startuml builder
title Builder - Naves del Hangar
skinparam classAttributeIconSize 0
hide empty members

package "Kepler7.Game" {
  class PantallaHangar
}

package "Kepler7.Core" {
  class Partida <<cliente>> {
    +NaveDeApoyo : Nave
    +EnsamblarNave(receta : INaveBuilder) : Nave
    +EmpezarOleada() : Oleada
  }

  class IngenieroJefe <<director>> {
    +Ensamblar(receta : INaveBuilder) : Nave
  }

  interface INaveBuilder <<builder>> {
    +Nombre : string
    +Descripcion : string
    +Reiniciar()
    +ConstruirCasco()
    +InstalarMotor()
    +InstalarEscudo()
    +InstalarArmas()
    +InstalarRadar()
    +InstalarIA()
    +CargarTanques()
    +MontarBodega()
    +ObtenerNave() : Nave
  }

  class RecetaExploradora
  class RecetaCombate
  class RecetaCarga

  class Nave <<producto>> {
    +Modelo : string
    +Casco : string
    +Motor : string
    +Escudo : int
    +Armas : int
    +Radar : bool
    +IA : string
    +Tanques : int
    +Bodega : int
    +Piezas : IReadOnlyList<PiezaNave>
    +RevelaIA : bool
    +DanioDeApoyo : int
    +BonusCreditos : int
    +Apoyo : string
  }

  class PiezaNave {
    +Componente : string
    +Detalle : string
  }

  class Oleada {
    +NaveDeApoyo : Nave
    +RecibirApoyo(nave : Nave)
  }
}

PantallaHangar --> Partida : receta elegida
Partida --> IngenieroJefe
Partida ..> Oleada : entrega la nave
IngenieroJefe ..> INaveBuilder : llama los pasos en orden

RecetaExploradora ..|> INaveBuilder
RecetaCombate ..|> INaveBuilder
RecetaCarga ..|> INaveBuilder

RecetaExploradora ..> Nave : arma
RecetaCombate ..> Nave : arma
RecetaCarga ..> Nave : arma
Nave *-- "*" PiezaNave
Oleada --> Nave : usa el apoyo

note right of IngenieroJefe
  Conoce el orden de armado,
  no las piezas. La misma
  secuencia da tres naves
  distintas según la receta.
end note

note bottom of RecetaCarga
  Los pasos de componentes
  que no lleva (armas, radar,
  IA) no hacen nada.
end note
@enduml
