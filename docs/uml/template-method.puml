@startuml template-method
title Template Method - Turno de cada unidad
skinparam classAttributeIconSize 0
hide empty members

package "Kepler7.Game" {
  class PantallaOleada
}

package "Kepler7.Core" {
  class Oleada {
    +ClasesQueJugaron : IReadOnlyCollection<ClaseUnidad>
    +Mover(unidad)
    +Atacar(unidad, objetivo)
    +Curar(medico, objetivo)
    +Construir(unidad)
    -JugarTurno(unidad, orden)
  }

  abstract class TurnoUnidad {
    #Unidad : UnidadEscuadron
    #Campo : CampoBatalla
    #Bonus : int
    +{static} Para(unidad, campo) : TurnoUnidad
    +EjecutarTurno(orden, gestor, historial) : IComando
    +{abstract} Habilidad : string
    #{abstract} Iniciar() : string
    #{abstract} Decidir(orden) : string
    #Finalizar() : string
    -CrearComando(orden) : IComando
  }

  class TurnoSoldado {
    #Iniciar() : string
    #Decidir(orden) : string
  }

  class TurnoMedico {
    #Iniciar() : string
    #Decidir(orden) : string
    #Finalizar() : string
  }

  class TurnoFrancotirador {
    #Iniciar() : string
    #Decidir(orden) : string
    #Finalizar() : string
  }

  class TurnoComandante {
    #Iniciar() : string
    #Decidir(orden) : string
    #Finalizar() : string
  }

  class OrdenTurno {
    +Tipo : TipoOrden
    +Objetivo : Unidad
  }

  enum TipoOrden {
    Mover
    Atacar
    Curar
    Construir
  }

  class GestorComandos
  class Bitacora
  interface IComando
}

PantallaOleada --> Oleada : acciones del jugador
Oleada ..> TurnoUnidad : Para(unidad).EjecutarTurno(orden)
Oleada ..> OrdenTurno : crea

TurnoSoldado --|> TurnoUnidad
TurnoMedico --|> TurnoUnidad
TurnoFrancotirador --|> TurnoUnidad
TurnoComandante --|> TurnoUnidad

TurnoUnidad ..> OrdenTurno
OrdenTurno --> TipoOrden
TurnoUnidad ..> IComando : crea en la etapa de acción
TurnoUnidad ..> GestorComandos : ejecuta el comando
TurnoUnidad ..> Bitacora : registra cada etapa

note right of TurnoUnidad
  EjecutarTurno() no es virtual.
  Orden fijo de las etapas:
  1. Iniciar()
  2. Decidir(orden)
  3. crear y ejecutar el comando
  4. Finalizar()
end note

note bottom of TurnoFrancotirador
  Decidir(): si ataca desde
  atrás, Bonus = 3.
end note
@enduml
