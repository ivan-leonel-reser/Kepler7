<Project Sdk="Microsoft.NET.Sdk">

  <!-- Interfaz. Habla con Core y usa las entidades y los servicios; a la capa de datos no la ve:
       sin referencias transitivas, usar Kepler7.DAL desde un Form no compila. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Las pantallas están armadas en píxeles: con la escala de Windows al 125 % o 150 % la agranda Windows entera. -->
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kepler7.Core\Kepler7.Core.csproj" />
    <ProjectReference Include="..\Kepler7.BE\Kepler7.BE.csproj" />
    <ProjectReference Include="..\Kepler7.Services\Kepler7.Services.csproj" />
  </ItemGroup>

  <!-- La cadena de conexión viaja al lado del ejecutable para poder cambiarla sin recompilar. -->
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
